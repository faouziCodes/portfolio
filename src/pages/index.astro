---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MeAvatar from "../components/MeAvatar";
import MediaIcons from "@/components/MediaIcons.astro";
import { Separator } from "@/components/ui/separator";
import {
    JavascriptIcon,
    LaravelIcon,
    OcamlIcon,
    RustIcon,
} from "@/components/icons";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const expertise = [
    { name: "JavaScript", Icon: JavascriptIcon, color: "#F7DF1E" },
    { name: "Rust", Icon: RustIcon, color: "#000000" },
    { name: "OCaml", Icon: OcamlIcon, color: "#EC6813" },
    { name: "Laravel", Icon: LaravelIcon, color: "#FF2D20" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main class="w-page h-page gap-4 flex flex-col items-center justify-center-safe mt-40">
            <MeAvatar client:load />

            <div class="text-center">
                <h1 class="text-2xl font-semibold tracking-tight">Faouzi</h1>
                <p class="text-sm text-muted-foreground">
                    Full-stack developer & open source contributor
                </p>
            </div>

            <MediaIcons />

            <Separator className="my-2 max-w-xs" />

            <div class="max-w-md space-y-4 text-center text-sm text-muted-foreground">
                <p>
                    I'm a programmer that loves many different technologies —
                    I work across the backend and frontend, write side
                    projects, and have contributed to a big open source
                    project.
                </p>
                <p>
                    I started programming in 2019, and since then I've
                    learned a lot, both at school and on my own. I've written
                    several side projects, ranging from simple web apps to
                    programming languages.
                </p>
                <p class="rounded-lg border border-border bg-muted/40 px-4 py-3 text-foreground">
                    I've also worked at <strong>Dutch Height</strong>, a Dutch
                    tech company, where I learned to write embedded code
                    using Rust.
                </p>
            </div>

            <Separator className="my-2 max-w-xs" />

            <div class="flex flex-col items-center gap-3">
                <h2 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                    Expertise
                </h2>
                <ul class="flex flex-wrap items-center justify-center gap-6">
                    {expertise.map(({ name, Icon, color }) => (
                        <li class="flex flex-col items-center gap-1.5">
                            <Icon width={28} height={28} style={{ color }} />
                            <span class="text-xs text-muted-foreground">{name}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </main>
        <Footer />
    </body>
</html>
